# Vamanan GPT is a cultural AI experience. In chat mode, Vamanan draws live
# answers from Google's Gemini API. A local storytelling engine handles story,
# quiz and acts as a graceful fallback, so the app never breaks without a key.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: canonical site URL used for social share cards (falls back to
# the Vercel production domain when unset)
NEXT_PUBLIC_SITE_URL=https://vamanan-gpt.vercel.app
