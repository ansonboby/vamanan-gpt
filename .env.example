# Vamanan GPT is a cultural AI experience. In chat mode, Vamanan draws live
# answers from GLM 5.3 via TokenRouter, falling back to a chain of Google
# Gemini models. A local storytelling engine handles story, quiz and acts
# as a graceful final fallback, so the app never breaks without keys.

# Optional — primary chat model (free key at https://tokenrouter.ai)
TOKENROUTER_API_KEY=

# Optional — Gemini fallback chain (free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: first Gemini model in the fallback chain (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: canonical site URL used for social share cards (falls back to
# the Vercel production domain when unset)
NEXT_PUBLIC_SITE_URL=https://vamanan-gpt.vercel.app
